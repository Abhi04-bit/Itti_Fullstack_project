# Environment Configuration - The Itti Foundation
# IMPORTANT: Use placeholders only. Never commit real production secrets.

# Application
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/itti_foundation?schema=public"

# DPDP Act 2023 Compliance & Security
DATA_RETENTION_DAYS=365
CORS_ALLOWED_ORIGINS="http://localhost:3000,https://itti.org.in"

# Transactional Email (Resend / Brevo) - Optional in dev
RESEND_API_KEY=""
SUPPORT_EMAIL="hello@itti.org.in"
GRIEVANCE_OFFICER_EMAIL="hello@itti.org.in"

# Payment Gateway (Razorpay) - Optional / Mocked in dev
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
